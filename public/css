/* Queue status refinements - keeps the original MEDICARE teal design */
.queue-metrics{grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin-top:16px}
.queue-metrics .metric{min-width:0;min-height:125px;display:flex;flex-direction:column;justify-content:center;box-shadow:0 8px 24px #174b4208;transition:transform .2s,border-color .2s}
.queue-metrics .metric:hover{transform:translateY(-3px);border-color:#c5e1d6}
.queue-metrics .metric small{font-size:9px;font-weight:800;letter-spacing:.09em;color:#78918a;line-height:1.5}
.queue-metrics .metric b{font-size:clamp(19px,2vw,25px);color:var(--deep);overflow-wrap:anywhere}
.metric-note{display:block;margin-top:7px;color:#8a9b95;font-size:10px;line-height:1.5}
.arrival-metric{background:#f3faf6;border-color:#dceee4}
.call-metric{background:#f0f8f7;border-color:#d9ebe7}
.queue-reminder{margin-top:18px;padding:20px 22px;border:1px solid #dceee4;background:linear-gradient(110deg,#edf7f1,#f6faf7);color:#50756a;font-size:12px}
.queue-reminder strong{display:block;color:#174b4d;font:700 13px Manrope;margin-bottom:8px}
.queue-reminder p{margin:5px 0;line-height:1.7}
.queue-actions{display:flex;gap:10px;margin-top:17px}
.btn-cancel-appointment{background:#fff0ed;color:#ad5d54;border:1px solid #f5dcd7}
.btn-cancel-appointment:hover{background:#fbe2dd}
@media(max-width:1000px){.queue-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:420px){.queue-metrics{grid-template-columns:1fr 1fr;gap:8px}.queue-metrics .metric{padding:13px;min-height:112px}.queue-metrics .metric b{font-size:19px}.metric-note{font-size:9px}.queue-reminder{padding:15px}}
